# Copy to .env (git-ignored) and fill in. Never commit real values.

# Enhancv API key (Account Settings > Profile > API Keys, Business Plus plan). Starts with enh_live_
ENHANCV_API_KEY=

# --- HTTP mode (Docker / MCP_TRANSPORT=http) ---------------------------------------------------
# Bearer token that MCP clients must send. Generate one: openssl rand -hex 32
MCP_HTTP_AUTH_TOKEN=
# Host names clients use to reach the server (DNS rebinding protection). Required when binding beyond localhost.
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional ----------------------------------------------------------------------------------
# MCP_TRANSPORT=stdio                 # stdio (default) or http
# MCP_HTTP_HOST=127.0.0.1             # bind address (the Docker image uses 0.0.0.0)
# MCP_HTTP_PORT=3000
# ENHANCV_FILES_DIR=/absolute/path    # enables file_path/output_path tools below this directory (off by default)
# ENHANCV_MAX_RETRY_WAIT_MS=30000     # longest single wait for a 429 retry
# ENHANCV_API_URL=                    # override only for tests/mocks (https required outside localhost)
